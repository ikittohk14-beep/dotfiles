{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 420,
  "control-center-height": 720,
  "notification-window-width": 420,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Центр управления",
      "clear-all-button": true,
      "button-text": "Очистить"
    },
    "dnd": {
      "text": "Не беспокоить"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨 Wi-Fi",
          "type": "toggle",
          "active": true,
          "command": "nmcli radio wifi `[[ $(nmcli radio wifi) == 'enabled' ]] && echo 'off' || echo 'on'`"
        },
        {
          "label": "󰂯 Bluetooth",
          "type": "toggle",
          "active": true,
          "command": "bluetoothctl power `[[ $(bluetoothctl show | grep 'Powered: yes') ]] && echo 'off' || echo 'on'`"
        },
        {
          "label": "󰔎 Ночной свет",
          "type": "toggle",
          "active": false,
          "command": "pkill wlsunset || wlsunset -T 4500"
        },
        {
          "label": "󰂛 DND",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d -sw"
        },
        {
          "label": "󰄀 Скриншот",
          "command": "grim -g \"$(slurp)\" - | wl-copy"
        },
        {
          "label": "󰌾 Блокировка",
          "command": "~/driftwm/extras/scripts/lock.sh"
        }
      ]
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 12
    }
  }
}
