{
  "reload_style_on_change": true,
  "name": "mainbar",
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 44,
  "margin-right": 10,
  "margin-left": 10,
  "margin-top": 4,

  "modules-left": [
    "custom/omarchy",
    "custom/active_window"
  ],
  "modules-center": [
    "group/center3",
    "custom/user",
    "group/center2",
    "custom/weather"
  ],
  "modules-right": [
    "group/right1"
  ],

  "custom/omarchy": {
    "format": "",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "custom/active_window": {
    "exec": "~/.config/waybar/window.sh",
    "return-type": "json",
    "markup": true
  },

  "group/center3": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "custom/separator#blank",
      "custom/media"
    ]
  },

  "cpu": {
    "interval": 2,
    "format": "{icon} ",
    "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "tooltip-format": "CPU: {usage}%"
  },

  "memory": {
    "interval": 2,
    "format": "{icon} ",
    "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB"
  },

  "custom/media": {
    "exec": "~/.config/waybar/media.py",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.config/waybar/media.py --action play-pause",
    "on-click-right": "~/.config/waybar/media.py --action next",
    "on-click-middle": "~/.config/waybar/media.py --action previous"
  },

  "custom/user": {
    "format": "  ikitto",
    "tooltip": false
  },

  "group/center2": {
    "orientation": "horizontal",
    "modules": [
      "clock"
    ]
  },

  "clock": {
    "format": "{:%H:%M • %a, %d/%m}",
    "format-alt": "{:%A, %d %B %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/weather": {
    "exec": "~/.config/waybar/weather.py",
    "return-type": "json",
    "interval": 600,
    "tooltip": true
  },

  "group/right1": {
    "orientation": "horizontal",
    "modules": [
      "group/tray-drawer",
      "pulseaudio",
      "pulseaudio/slider",
      "bluetooth",
      "network"
    ]
  },

  "group/tray-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "tray-child",
      "transition-left-to-right": true
    },
    "modules": [
      "custom/tray-arrow",
      "tray"
    ]
  },

  "custom/tray-arrow": {
    "format": "|",
    "tooltip": false
  },

  "tray": {
    "icon-size": 15,
    "spacing": 8
  },

  "custom/separator#blank": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },

  "custom/separator#dot": {
    "format": "",
    "interval": "once",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "<span size='11500'>{icon}</span>",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Громкость: {volume}%",
    "scroll-step": 5,
    "format-muted": "  ",
    "format-icons": {
      "default": [" ", " ", " "]
    }
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "bluetooth": {
    "format": "<span size='11500'>󰂯</span>",
    "format-disabled": "<span size='11500'>󰂲</span>",
    "format-connected": "<span size='11500'></span>",
    "tooltip-format": "Подключено: {num_connections}",
    "tooltip-format-connected": "{device_alias}"
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "<span size='11500'>󰌘</span>",
    "format-disconnected": "<span size='11500'>󰤮</span>",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}",
    "interval": 3
  }
}
